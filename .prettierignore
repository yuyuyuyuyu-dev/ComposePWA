# Prettier reads .gitignore by default, so this file only lists what that misses.

# A drop-in user project: it stays exactly as the IDE template generates it, so that
# readers can tell at a glance what the plugin produced. No formatter or linter runs
# over it.
example/

# Ignored by a nested .gitignore (tmp/.gitignore); Prettier reads only the root one.
tmp/

# Claude Code's local settings: not committed, and known only to the developer's
# global gitignore, which Prettier does not read either.
.claude/
