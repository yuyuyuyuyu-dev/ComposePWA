# Web assets the ComposePWA plugin generates inside the example app. These are
# git-ignored from the root (not from example/.gitignore) so that replacing the
# example with a freshly generated project never drops these rules. They are kept out
# of Git on purpose so CI can verify the plugin actually regenerates them; a real
# consumer app would commit them.
/example/webApp/workbox-config-for-wasm.js
/example/webApp/workbox-config-for-js.js
/example/webApp/src/webMain/resources/manifest.json
/example/webApp/src/webMain/resources/icons/*
/example/webApp/src/webMain/resources/registerServiceWorker.js

# Kotlin/JS + Wasm yarn lockfiles for the example: regenerated by CI on every run.
/example/kotlin-js-store/
