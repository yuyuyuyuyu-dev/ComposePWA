{
  "config": {
    "default": true,
    // Line length is governed by Prettier (prose is wrapped manually).
    "MD013": false,
    // Inline HTML is required for README badges and images.
    "MD033": false
  },
  "globs": ["**/*.md"],
  // Covers build outputs, tool caches and the tmp/ scratch workspace — including the
  // nested tmp/.gitignore.
  "gitignore": true,
  // A drop-in user project: it stays exactly as the IDE template generates it, so that
  // readers can tell at a glance what the plugin produced.
  "ignores": ["example/**"]
}
